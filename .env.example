# ─── Supabase connection ──────────────────────────────────────────────────────
# Required for database mode. Get these from:
#   https://app.supabase.com → your project → Project Settings → API
#
# Copy this file to .env.local (never commit .env.local).

# Project base URL — NOT the /rest/v1/ API URL. Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key — safe to expose in the browser bundle.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Server-side / local-editing key ─────────────────────────────────────────
# The service_role key bypasses RLS. Two uses:
#
#   1. scripts/*.ts (seed, export-static, detect-changes, approve-change) —
#      server-side, also set as a GitHub Actions secret.
#   2. LOCAL EDITING. When this is set, `npm run dev` injects it into the
#      browser client and the Add/Edit/Delete/Merge controls appear. Without
#      it the local app is read-only, exactly like the deployed site.
#
# vite.config.ts injects this ONLY when serving (`command === "serve"`); every
# `vite build` substitutes an empty string, so it can never reach a deployed
# bundle. Deliberately NOT VITE_-prefixed — prefixed vars are exposed to client
# code in every mode. Never add it to .github/workflows/deploy.yml.
#
# Get from: Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
