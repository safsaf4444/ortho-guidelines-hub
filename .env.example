# ─── Supabase connection ──────────────────────────────────────────────────────
# Required for database mode. Get these from:
#   https://app.supabase.com → your project → Project Settings → API
#
# Copy this file to .env.local (never commit .env.local).

# Project base URL — NOT the /rest/v1/ API URL. Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key — safe to expose in the browser bundle.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Server-side key ─────────────────────────────────────────────────────────
# The service_role key bypasses RLS. Used ONLY by scripts/*.ts (seed,
# export-static, detect-changes, approve-change) and the matching GitHub
# Actions secrets.
#
# It is NOT used by the browser client in any mode. Editing in the app works
# through the public anon key, because write permission is granted by RLS
# (see SECURITY.md). Never add this key to .github/workflows/deploy.yml or
# give it a VITE_ prefix — a build must never contain it.
#
# Get from: Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
