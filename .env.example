# ─── Supabase connection ──────────────────────────────────────────────────────
# Required for database mode. Get these from:
#   https://app.supabase.com → your project → Project Settings → API
#
# Copy this file to .env.local (never commit .env.local).

# Project base URL — NOT the /rest/v1/ API URL. Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key — safe to expose in the browser bundle.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Seed script only ─────────────────────────────────────────────────────────
# Service role key bypasses RLS — only used in scripts/seed.ts, NEVER in browser
# or frontend code. Get from: Project Settings → API → service_role (secret).
#
# If omitted, the seed script falls back to the anon key (fine when RLS is off).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
