# Local browser configuration ONLY. Copy to .env.local if needed.
# With missing variables the app uses its static catalogue and creates no client.
# No production defaults exist in src/lib/supabase.ts.
#
# Optional disposable local Supabase (public anon key only):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Leave unset for normal development, preview, accessibility and browser tests.
# Set to the exact string true ONLY after separate approval to access a remote
# database from a non-deployed app. This is deliberate connectivity, not a test.
# Test mode (--mode test) refuses remote targets even when this flag is true.
# VITE_ALLOW_REMOTE_SUPABASE_IN_LOCAL=true

# Never put service_role, sb_secret_ or a VITE_-prefixed server key here.
# Server-side operational scripts require their own separately authorised setup.
# The unchanged deployment workflow supplies production URL/public key explicitly.
